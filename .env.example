# LM Studio settings used by the Week 8 exercises
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
LM_STUDIO_API_KEY=lm-studio
LM_STUDIO_CHAT_MODEL=qwen2.5-coder-1.5b-instruct
LM_STUDIO_EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5

# The router can point both branches at one local model
ROUTER_MODEL=qwen2.5-coder-1.5b-instruct
MAIN_LLM=qwen2.5-coder-1.5b-instruct
SMALL_LLM=qwen2.5-coder-1.5b-instruct

CACHE_THRESHOLD=0.35
BUDGET_LIMIT=5.00
